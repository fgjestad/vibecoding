# Anthropic API-nøkkel (kreves for "oppdag nye kilder", bildetolkning og artikkelgenerering)
ANTHROPIC_API_KEY=

# Modell som brukes til artikkelgenerering og kildeforslag (standard: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Modell som brukes til innhøsting (uttrekk av arrangementer fra kilder). Kan settes til en
# annen modell enn ANTHROPIC_MODEL for å kjøre innhøsting billigere. Merk at modellen må
# støtte output_config.effort og web_fetch_20260209 — Haiku 4.5 gjør ikke det, og feiler
# stille på deler av innhøstingen.
ANTHROPIC_MODEL_INNHOSTING=claude-sonnet-5

# Enkelt passordvern for nettgrensesnittet (HTTP basic auth) — admin-tilgang, inkludert
# kildelisten
APP_BRUKER=raumnes
APP_PASSORD=

# Valgfri egen pålogging for journalister (kun innhøsting og artikler, ikke kildelisten).
# La stå tomme for å ikke ha noen journalist-pålogging i det hele tatt — se README.md.
APP_BRUKER_JOURNALIST=
APP_PASSORD_JOURNALIST=

# Databasefil (SQLite). La stå som standard lokalt.
DATABASE_URL=sqlite:///./data.db
