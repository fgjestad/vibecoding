# Passordet som kreves for å endre noe i oversikten. Lesere trenger ikke passord.
# Uten denne satt kan ingen logge inn.
ADMIN_PASSORD=

# Signerer innloggingen. Sett en lang, tilfeldig streng i produksjon — da beholdes
# innloggingen selv om passordet byttes eller appen starter på nytt.
SECRET_KEY=

# Databasefil (SQLite). La stå som standard lokalt. På Render peker den på den
# monterte disken: sqlite:////data/data.db
DATABASE_URL=sqlite:///./data.db
