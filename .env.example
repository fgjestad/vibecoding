# Alt er valgfritt. Uten disse kjører appen på mocks, som er meningen
# inntil tilgangene er på plass.

# --- Google Cloud ---
# GCP_PROJECT=amedia-moteskriver
# GCP_REGION=europe-north1

# --- Flowplayer ---
# FLOWPLAYER_API_KEY=            # header: x-flowplayer-api-key
# FLOWPLAYER_API_KEY=

# --- AssemblyAI (talegjenkjenning) ---
# Lag konto: https://www.assemblyai.com/dashboard/signup
# ASSEMBLYAI_API_KEY=

# --- Motorvalg ---
# ASR_PROVIDER=mock          # mock | assemblyai | gemini | google-stt
# VIDEO_PROVIDER=mock        # mock | flowplayer | embed
#
# "embed" er reserveveien: henter mediefila fra Flowplayers offentlige
# embed-modul uten API-nøkkel. Krever bare publisher-ID-en ("pi" i
# embed-lenka), som er konstant per avis.
# FLOWPLAYER_PUBLISHER_ID=c15f9570-1ac3-4089-adeb-2991e2442ff1

# --- Claude ---
# Uten GCP_PROJECT går kallene mot Claude API direkte og trenger ANTHROPIC_API_KEY.
# Med GCP_PROJECT går de via Vertex AI på GCP-autentisering (ADC).
# ANTHROPIC_API_KEY=

# --- Adgangskontroll (Google SSO) ---
# Uten disse nekter tjenesten å svare utenfor localhost – den skal ikke
# kunne stå åpen på internett ved et uhell.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=            # en lang tilfeldig streng
# PUBLIC_URL=https://moteskriver.onrender.com
# ALLOWED_DOMAIN=amedia.no

# --- Cue-eksport ---
# Les av fra adressefeltet når du starter en ny artikkel i Cue.
# Vert og publikasjon er ikke nødvendigvis like.
# CUE_HOST=https://raumne.cue.api.no
# CUE_PUBLICATION=raumnes
