# Anthropic API-nøkkel (kreves for "oppdag nye kilder", bildetolkning og artikkelgenerering)
ANTHROPIC_API_KEY=

# Modell som brukes for LLM-kall (standard: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# Enkelt passordvern for nettgrensesnittet (HTTP basic auth)
APP_BRUKER=raumnes
APP_PASSORD=

# Databasefil (SQLite). La stå som standard lokalt.
DATABASE_URL=sqlite:///./data.db
